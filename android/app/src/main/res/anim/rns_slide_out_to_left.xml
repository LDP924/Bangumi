<?xml version="1.0" encoding="utf-8"?>
<!--
  覆盖 react-native-screens 的同名动画资源。水平切换时旧页出场。

  内容 = 库内原版, 时长引用 @integer/transition_duration, 详见 rns_slide_in_from_right.xml;
  必须与 rns_slide_in_from_right 同时长, 位移保持 100% (视差会花屏)。
-->
<translate xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/transition_duration"
    android:fromXDelta="0%"
    android:toXDelta="-100%" />
